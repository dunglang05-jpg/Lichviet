<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <receiver android:name="vn.lichviet.widget.DayWidget" android:exported="false" android:label="@string/w_day">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_day_info" />
        </receiver>
        <receiver android:name="vn.lichviet.widget.DetailWidget" android:exported="false" android:label="@string/w_detail">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_detail_info" />
        </receiver>
        <receiver android:name="vn.lichviet.widget.MonthWidget" android:exported="false" android:label="@string/w_month">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_month_info" />
        </receiver>
        <receiver android:name="vn.lichviet.widget.WidgetRefreshReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="vn.lichviet.widget.MIDNIGHT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
